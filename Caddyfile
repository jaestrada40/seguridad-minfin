{
	# Certificado autofirmado generado automáticamente por la CA interna de Caddy
	# (apropiado para "local"; para un dominio real, Caddy pediría uno público
	# automáticamente vía ACME en vez de usar `tls internal`).
	local_certs
}

https://localhost:8443 {
	tls internal

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; connect-src 'self' ws: wss:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /health {
		reverse_proxy backend:8000
	}

	# La app se sirve solo bajo una ruta secreta (APP_SECRET_PATH en .env).
	# Con el valor por defecto "/" el matcher cubre todo y se comporta como antes.
	@app path {$APP_SECRET_PATH:/}*
	handle @app {
		reverse_proxy frontend:3000
	}

	# La ruta secreta sin barra final redirige a la versión con barra
	# (en modo por defecto este bloque es inalcanzable: @app ya cubrió "/").
	@app_exact path {$APP_SECRET_PATH:/}
	handle @app_exact {
		redir {$APP_SECRET_PATH:/}/ 308
	}

	# Cualquier otra ruta (incluida "/") no revela que hay algo acá.
	handle {
		respond "Not Found" 404
	}
}
