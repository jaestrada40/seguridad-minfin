# Sirve el bundle estático de la SPA. El proxy (openshift/08-proxy) le hace
# strip del prefijo de la ruta secreta, así que acá siempre servimos desde "/".
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode gzip zstd
	try_files {path} /index.html
	file_server

	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header Cache-Control "no-cache"
}
