# Genere cada valor de forma independiente, por ejemplo: openssl rand -base64 48
ADMIN_USERNAME=admin.local
ADMIN_PASSWORD=REEMPLAZAR_CON_UNA_CLAVE_ALEATORIA_DE_32_CARACTERES_O_MAS
SESSION_SECRET=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS
BACKUP_ENCRYPTION_KEY=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS

# Ruta secreta bajo la que se sirve la app. Con "/" (por defecto) la app está
# en la raíz como siempre. Con otro valor (ej. /mf-0bff4a), "/" devuelve 404 y
# solo esa ruta lleva al login — una capa extra de ofuscación, NO reemplaza el
# login/MFA. Guárdala en tu gestor de contraseñas; si la pierdes, cámbiala acá.
APP_SECRET_PATH=/
